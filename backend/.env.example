# Example environment variables for FindMeTricycle backend
# Copy this file to `.env` and fill in real secrets before running in development.

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=findmetricycle

# JWT / auth
JWT_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# App / server
PORT=5000
CLIENT_ORIGIN=http://localhost:5176

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Brevo SMTP (OTP + driver-application emails). Sign up free at https://www.brevo.com/
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=replace_with_brevo_smtp_login
BREVO_SMTP_PASSWORD=replace_with_brevo_smtp_password
BREVO_FROM_EMAIL=replace_with_from_address

# Google reCAPTCHA v2 (Driver Application Website). Register a free site at
# https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=replace_with_recaptcha_secret_key

# Service area. Bookings outside the radius are rejected only when
# GEOFENCE_ENABLED=true (leave false while testing from elsewhere).
GEOFENCE_ENABLED=false
GEOFENCE_CENTER_LAT=11.033
GEOFENCE_CENTER_LNG=125.722
GEOFENCE_RADIUS_KM=50
