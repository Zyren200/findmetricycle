# Example environment variables for FindMeTricycle backend
# Copy this file to `.env` and fill in real secrets before running in development.

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=findmetricycle

# JWT / auth
JWT_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# App / server
PORT=5000
CLIENT_ORIGIN=http://localhost:5176
# Admin dashboard sign-in page, linked from new-admin and password-reset
# emails (optional).
ADMIN_DASHBOARD_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Brevo HTTPS API (OTP + driver-application emails). Sign up free at https://www.brevo.com/
# API key: Brevo > SMTP & API > API Keys. BREVO_FROM_EMAIL must be a verified sender.
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_FROM_EMAIL=replace_with_verified_sender_email
# Sender name on Contact Support replies (sent from BREVO_FROM_EMAIL).
SUPPORT_FROM_NAME=support.findmetricycle

# Google reCAPTCHA v2 (Driver Application Website). Register a free site at
# https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=replace_with_recaptcha_secret_key

# Service area. Bookings and saved places outside Guiuan are rejected only
# when GEOFENCE_ENABLED=true — set it to true in production; leave it false
# only while testing from outside Guiuan. SOS alerts, driver locations and
# rides already under way are never blocked.
GEOFENCE_ENABLED=false
# polygon = Guiuan's municipal boundary, islands included
# (backend/data/service-area/guiuan.geojson); radius = the circle below.
GEOFENCE_MODE=polygon
# How far past the boundary still counts as inside (GPS error near borders
# and coastlines).
GEOFENCE_BUFFER_METERS=300
# Used only with GEOFENCE_MODE=radius.
GEOFENCE_CENTER_LAT=11.033
GEOFENCE_CENTER_LNG=125.722
GEOFENCE_RADIUS_KM=50

# Push notifications (Firebase Cloud Messaging). Firebase console → Project
# settings → Service accounts → Generate new private key, save the JSON in
# backend/ and point to it here. Leave blank to keep push off.
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json

# SOS: minutes an alert may stay unacknowledged before every Super Admin is
# alerted (default 2).
SOS_ESCALATION_MINUTES=2
